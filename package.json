{
    "name": "servicenow-doom",
    "version": "0.0.1",
    "description": "",
    "license": "UNLICENSED",
    "imports": {
        "#now:*": "./@types/servicenow/fluent/*/index.js"
    },
    "scripts": {
        "build": "now-sdk build",
        "deploy": "now-sdk install",
        "transform": "now-sdk transform",
        "types": "now-sdk dependencies",
        "assets": "node scripts/fetch-doom-assets.mjs",
        "prebuild": "npm run assets",
        "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./dev/register.mjs dev/server.mjs",
        "test:server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./dev/register.mjs --test dev/test-server.mjs",
        "test:client": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test dev/test-client.mjs",
        "test": "npm run test:client && npm run test:server"
    },
    "devDependencies": {
        "@servicenow/sdk": "4.13.6",
        "@servicenow/glide": "27.0.5",
        "typescript": "5.5.4"
    }
}
